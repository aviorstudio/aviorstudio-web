---
import AviorMark from '../components/AviorMark.astro';
import Full from '../layouts/Full.astro';

const earlier = [
	{ src: '/art/identity/enso-cradle.svg', name: 'Enso cradle, 2026' },
	{ src: '/art/identity/ibis-badge.svg', name: 'Game badge' },
	{ src: '/art/identity/ibis-pond.svg', name: 'Pond emblem' },
	{ src: '/art/identity/ibis-seal.svg', name: 'Studio seal' },
];
---

<Full
  title="Avior Studio — Identity"
  description="The Avior Studio mark: a dry-brush ibis standing in still water inside a dry-brush ring, painted once and animated as a cut-out sprite."
  noindex
>
  <main id="main-content" class="identity">
    <a class="back" href="/">
      ← Back to the studio
    </a>
    <p class="eyebrow">AVIOR STUDIO / IDENTITY</p>
    <h1>An ibis, <em>at rest.</em></h1>
    <p class="intro">
      A white ibis stands in still water inside a ring laid down with a dry brush. It was painted once,
      on a transparent ground, then cut into parts and animated as a spritesmith cut-out sprite: the
      ring paints itself in, rests and fades, while the reflection breathes in a slow wave.
    </p>

    <section class="mark" aria-labelledby="mark-title">
      <div class="hero">
        <AviorMark />
      </div>
      <div class="copy">
        <h2 id="mark-title">The mark</h2>
        <p>
          Bone white on charcoal. The bird holds still and the water moves. The ring opens at the lower left,
          so the bird reads as held rather than enclosed. Where motion is unwelcome, the mark rests with its
          ring complete.
        </p>
        <div class="bar">
          <img src="/mark/mark-96.png" alt="" width="44" height="44" />
          <span>Avior Studio</span>
        </div>
        <div class="icons">
          <span>Tile sizes</span>
          {[48, 32, 16].map((size) => (
            <div>
              <img src="/favicon.png" alt="" width={size} height={size} />
              <small>{size}px</small>
            </div>
          ))}
        </div>
        <p class="downloads">
          <a href="/mark/mark.png" download>Mark, transparent PNG</a>
          <a href="/logo-mark.png" download>Tile PNG</a>
          <a href="/logo.png" download>Share image PNG</a>
        </p>
      </div>
    </section>

    <h2 class="earlier-title">Earlier directions</h2>
    <p class="earlier-intro">The vector mark this one replaces, and three coloured directions from the first exploration, kept for reference.</p>
    <div class="earlier">
      {earlier.map((variant) => (
        <figure>
          <img src={variant.src} alt={`${variant.name}: an earlier ibis mark`} width="256" height="256" />
          <figcaption>{variant.name}</figcaption>
        </figure>
      ))}
    </div>
  </main>
</Full>

<style>
  .identity {
    width: min(1180px, calc(100% - 40px));
    margin: 32px auto 80px;
    color: var(--bone);
  }
  .back {
    color: var(--quiet);
    font-size: 14px;
  }
  .eyebrow {
    margin: 40px 0 16px;
    font: 600 11px var(--mono);
    letter-spacing: 0.08em;
  }
  h1 {
    font: 400 clamp(40px, 5vw, 66px) / 1.08 var(--serif);
    margin: 0 0 22px;
  }
  h1 em {
    color: var(--quiet);
  }
  .intro {
    max-width: 640px;
    font-size: 18px;
    line-height: 1.6;
    margin-bottom: 40px;
  }
  .mark {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
    background: var(--raised);
  }
  .hero {
    background: var(--ink);
    padding: 32px;
  }
  .copy {
    padding: 28px;
    display: grid;
    align-content: start;
    gap: 16px;
  }
  h2 {
    margin: 0;
    font: 400 28px var(--serif);
  }
  .copy > p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    border: 1px solid var(--line);
    border-radius: 10px;
    font: 500 21px var(--serif);
  }
  .icons {
    display: flex;
    gap: 18px;
    align-items: flex-end;
  }
  .icons > span {
    font-size: 12px;
    margin-right: auto;
    align-self: center;
  }
  .icons div {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .icons small {
    font: 10px var(--mono);
  }
  .downloads {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }
  .downloads a {
    color: var(--paper);
    font-size: 14px;
  }
  .earlier-title {
    margin-top: 56px;
  }
  .earlier-intro {
    margin: 8px 0 20px;
    font-size: 15px;
  }
  .earlier {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }
  .earlier figure {
    margin: 0;
    padding: 20px;
    background: var(--ink-deep);
    border-radius: 4px;
    text-align: center;
  }
  .earlier img {
    display: block;
    width: 60%;
    height: auto;
    margin: 0 auto 12px;
  }
  .earlier figcaption {
    font-size: 13px;
  }
  @media (max-width: 800px) {
    .identity {
      width: calc(100% - 28px);
    }
    .mark {
      grid-template-columns: 1fr;
    }
    .earlier {
      grid-template-columns: 1fr 1fr;
    }
    .hero {
      padding: 32px 64px;
    }
  }
</style>
