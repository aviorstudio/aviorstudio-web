---
import Full from '../layouts/Full.astro';

const earlier = [
	{ key: 'badge', name: 'Game badge' },
	{ key: 'pond', name: 'Pond emblem' },
	{ key: 'seal', name: 'Studio seal' },
];
---

<Full
  title="Avior Studio — Identity"
  description="The Avior Studio mark: a white ibis and its reflection cradled by a brush sweep."
  noindex
>
  <main id="main-content" class="identity">
    <a class="back" href="/">
      ← Back to the studio
    </a>
    <p class="eyebrow">AVIOR STUDIO / IDENTITY</p>
    <h1>An ibis, cradled.</h1>
    <p class="intro">
      One brush sweep thickens under a white ibis standing in still water. The mark is a
      flat silhouette drawn with Spritesmith, so it exports at any size with no raster source.
    </p>

    <section class="mark" aria-labelledby="mark-title">
      <div class="hero">
        <img src="/art/identity/enso-cradle.svg" alt="A white ibis standing above its reflection, cradled by a brush sweep" width="512" height="512" />
      </div>
      <div class="copy">
        <h2 id="mark-title">The mark</h2>
        <p>
          White on black. The sweep starts thin at the top left, passes under the water and ends thick
          at the right, so the bird reads as held rather than enclosed.
        </p>
        <div class="bar">
          <img src="/logo-mark.svg" alt="" width="40" height="40" />
          <span>Avior Studio</span>
        </div>
        <div class="icons">
          <span>Tile sizes</span>
          {[48, 32, 16].map((size) => (
            <div>
              <img src="/logo-mark.svg" alt="" width={size} height={size} />
              <small>{size}px</small>
            </div>
          ))}
        </div>
        <p class="downloads">
          <a href="/art/identity/enso-cradle.svg" download>Mark, transparent SVG</a>
          <a href="/art/identity/enso-cradle-tile.svg" download>Tile SVG</a>
          <a href="/logo.png" download>Share image PNG</a>
        </p>
      </div>
    </section>

    <h2 class="earlier-title">Earlier directions</h2>
    <p class="earlier-intro">Three coloured ibis directions from the first exploration, kept for reference.</p>
    <div class="earlier">
      {earlier.map((variant) => (
        <figure>
          <img src={`/art/identity/ibis-${variant.key}.svg`} alt={`${variant.name}: a coloured ibis standing in water`} width="256" height="256" />
          <figcaption>{variant.name}</figcaption>
        </figure>
      ))}
    </div>
  </main>
</Full>

<style>
  .identity {
    width: min(1180px, calc(100% - 40px));
    margin: 32px auto 80px;
    color: #203c42;
  }
  .back {
    color: #42665f;
    font-size: 14px;
  }
  .eyebrow {
    margin: 40px 0 16px;
    font: 600 11px var(--mono);
    letter-spacing: 0.08em;
  }
  h1 {
    font-size: clamp(36px, 5vw, 64px);
    letter-spacing: -0.045em;
    line-height: 1.08;
    margin: 0 0 22px;
  }
  .intro {
    max-width: 640px;
    font-size: 18px;
    line-height: 1.6;
    margin-bottom: 40px;
  }
  .mark {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    border: 1px solid #d6d8c9;
    border-radius: 16px;
    overflow: hidden;
    background: #fffaf0;
  }
  .hero {
    background: #000;
    padding: 48px;
  }
  .hero img {
    display: block;
    width: 100%;
    height: auto;
  }
  .copy {
    padding: 28px;
    display: grid;
    align-content: start;
    gap: 16px;
  }
  h2 {
    margin: 0;
    font-size: 25px;
    letter-spacing: -0.025em;
  }
  .copy > p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    border: 1px solid #d6d8c9;
    border-radius: 10px;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.025em;
  }
  .icons {
    display: flex;
    gap: 18px;
    align-items: flex-end;
  }
  .icons > span {
    font-size: 12px;
    margin-right: auto;
    align-self: center;
  }
  .icons div {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .icons small {
    font: 10px var(--mono);
  }
  .downloads {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }
  .downloads a {
    color: #28594d;
    font-size: 14px;
  }
  .earlier-title {
    margin-top: 56px;
  }
  .earlier-intro {
    margin: 8px 0 20px;
    font-size: 15px;
  }
  .earlier {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .earlier figure {
    margin: 0;
    padding: 20px;
    background: #f0ecdf;
    border-radius: 12px;
    text-align: center;
  }
  .earlier img {
    display: block;
    width: 60%;
    height: auto;
    margin: 0 auto 12px;
  }
  .earlier figcaption {
    font-size: 13px;
  }
  @media (max-width: 800px) {
    .identity {
      width: calc(100% - 28px);
    }
    .mark,
    .earlier {
      grid-template-columns: 1fr;
    }
    .hero {
      padding: 32px 64px;
    }
  }
</style>
