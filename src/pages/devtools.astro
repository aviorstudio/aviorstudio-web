---
import Full from '../layouts/Full.astro';

// The addons GDAM was built to carry. Listed alphabetically rather than by
// importance: fourteen is enough that a reader needs to be able to find one,
// and a ranking here would be an editorial claim the repositories cannot back.
//
// Every blurb comes from the addon's own README and plugin.cfg. Where one says
// what it deliberately leaves to the game, that is kept — the boundary is the
// most useful thing to know before installing.
const addons = [
	{
		name: 'gd-audio',
		tagline: 'Music and pooled sound effects',
		copy: 'One <code>GdAudio</code> autoload: configure a looping music stream with fades and a persisted volume, register named samples, then <code>play_sfx("click")</code>. Effects play out of a player pool you size. Volume is written to a config file you name, so the settings UI stays in the game.',
	},
	{
		name: 'gd-env',
		tagline: 'Environment and config loading',
		copy: 'Typed OS environment lookups with defaults, <code>.env</code> parsing, and JSON config from a file or an HTTP endpoint. It deliberately does not decide which source wins when several are present. Client-side config is public either way, so nothing here is a place for secrets.',
	},
	{
		name: 'gd-gesture',
		tagline: 'Pointer normalization and gestures',
		copy: 'Mouse and touch collapse into one typed pointer stream, and a recognizer turns that into tap, double tap, long press, swipe, drag and pinch. Use the global autoload for one shared stream, or the two modules directly when a split-screen or editor scene needs its own thresholds.',
	},
	{
		name: 'gd-network',
		tagline: 'HTTP, WebSocket and retry primitives',
		copy: 'A callback JSON HTTP client that uses <code>HTTPRequest</code> natively and a <code>JavaScriptBridge</code> fetch bridge on web, plus a request pool, token-bucket rate limiting, deterministic retry backoff, ordered delta windows and a shared error catalog. Auth, sessions, matchmaking and reconnect policy are left to the game.',
	},
	{
		name: 'gd-object-pool',
		tagline: 'Object and node reuse',
		copy: 'Acquire and return instances of any class instead of allocating per bullet, card or effect, with <code>warm_pool</code> to pre-allocate before gameplay and counters for created, reused, returned and disposed. Objects come back clean through a <code>reset</code> method or a callable you supply.',
	},
	{
		name: 'gd-observe',
		tagline: 'Local observability with a terminal dashboard',
		copy: 'Timers, gauges and counters alongside logs, events and per-frame traces, all tagged with a context you push and pop. A localhost WebSocket server streams them live to a terminal UI. Metrics are in-memory and local — the point is to see the data before deciding whether any of it should leave the machine.',
		cli: 'Ships gdobs, a Go terminal UI',
	},
	{
		name: 'gd-playwright',
		tagline: 'Named handles for web-export browser tests',
		copy: 'The addon writes element positions, events and test state to browser globals during a web run; the CLI reads them over CDP so a test can click <code>start_button</code> instead of a coordinate. The CLI is strictly read-only — it never mutates browser or game state. Disabled builds no-op, so the calls are safe to leave in.',
		cli: 'Ships gdpw, a Go CLI',
	},
	{
		name: 'gd-pocketbase',
		tagline: 'PocketBase auth and session primitives',
		copy: "Normalizes either a native <code>{token, record}</code> response or a backend proxy's <code>{access_token, user}</code> into one shape, then handles JWT expiry, persisted sessions and stable client IDs. Games keep HTTP transport and refresh policy; no superuser credential ever needs to reach the client.",
	},
	{
		name: 'gd-redis',
		tagline: 'A Redis client over RESP',
		copy: 'SET with a TTL, GET, DEL, cursor-based <code>scan_keys</code> rather than <code>KEYS</code>, and both blocking and non-blocking connects — for tools, dedicated servers and local utilities. <code>flushdb</code> stays disabled until dangerous commands are explicitly enabled, and web exports cannot open raw TCP at all.',
	},
	{
		name: 'gd-responsive',
		tagline: 'Layout that adapts to the viewport',
		copy: 'Breakpoint classification, scale, margins and content width computed from a <code>.tres</code> config, plus layout, flex and grid nodes that run as <code>@tool</code> scripts so the result is visible while authoring rather than only at runtime. Take just the scale module if you already have containers of your own.',
	},
	{
		name: 'gd-router',
		tagline: 'Editor-first screen routing',
		copy: 'A <code>GdRouter</code> autoload owns the route table, params and history while a <code>RouteHost</code> node mounts the active screen under a persistent main scene. Routes auto-discover from <code>*_screen/</code> folders while prototyping, or come from a committed route map so they are inspectable and reviewable in the editor.',
	},
	{
		name: 'gd-serialization',
		tagline: 'Objects to dictionaries and back',
		copy: 'Boundary conversion for saves, HTTP and WebSocket payloads and safe clones, with configurable class resolution, ignored properties and key normalization. It serializes script variables, not scene-tree state; cyclic graphs are unsupported, and reflection costs enough that it does not belong in a hot loop.',
	},
	{
		name: 'gd-supabase',
		tagline: 'Supabase session helpers',
		copy: 'JWT decoding and expiry checks, local session storage, and a stable client ID, without picking an auth UI or an HTTP client for you. It decodes tokens rather than verifying them, so refresh, revoke, encryption and server trust all stay deliberately on your side.',
	},
	{
		name: 'gd-telemetry',
		tagline: 'Event batching with no vendor attached',
		copy: 'Build structured events — timestamp, level, context and subject IDs, message, metadata — queue them, and flush on a size or time threshold into whatever transport you already have. It picks no analytics vendor and opens no sockets, which is the entire design.',
	},
];
---

<Full
	title="Devtools — Avior Studio"
	description="GDAM, gdlint and fourteen Godot addons. Tools from the workbench behind Avior Studio's games."
>
	<main id="main-content">
		<section class="tools-cover">
			<p class="eyebrow">THE STUDIO WORKBENCH</p>
			<h1>
				Less friction.
				<br />
				<em>More making.</em>
			</h1>
			<p>
				Tools that grew out of the games. Install the addons, check the scripts, and get back to the part you came to
				build.
			</p>
		</section>
		<section class="featured-tools">
			<article>
				<span class="tool-index">01 / DEPENDENCIES</span>
				<h2>GDAM</h2>
				<p>
					A package manager for Godot addons. Keep exact Release tags in one manifest and local development paths in
					their own file.
				</p>
				<div class="tool-sample">
					<code>
						gdam init
						<br />
						gdam add @aviorstudio/gd-router
						<br />
						gdam install
					</code>
				</div>
				<a href="https://gdam.dev">Meet GDAM ↗</a>
				<a href="https://app.gdam.dev">Browse the registry ↗</a>
			</article>
			<article>
				<span class="tool-index">02 / GDSCRIPT</span>
				<h2>gdlint</h2>
				<p>
					Check debug prints, stray pass statements, orphaned UIDs and indentation. Enable deeper checks when your
					project needs them.
				</p>
				<div class="tool-sample">
					<code>
						gdlint init
						<br />
						gdlint
						<br />
						<span>review before using -fix</span>
					</code>
				</div>
				<a href="https://gdlint.dev">Meet gdlint ↗</a>
				<a href="https://github.com/aviorstudio/gdlint">Get the source ↗</a>
			</article>
		</section>
		<section class="art-workbench">
			<div>
				<p class="eyebrow">03 / ORIGINAL GAME ART</p>
				<h2>
					One drawing.
					<br />
					<em>More than one screen.</em>
				</h2>
				<p>
					Spritesmith authors vector artwork in Python and exports it for the games. Its SVG export brings the same
					shapes to the web, at any size.
				</p>
				<p>The Castle Drop dragon and Prizm crystal here are original frames from their game art.</p>
			</div>
			<div class="vector-preview">
				<img src="/art/dragon.svg" alt="Castle Drop's red dragon" />
				<img src="/art/crystal.svg" alt="Prizm's purple crystal" />
			</div>
		</section>
		<section class="addon-catalog">
			<div class="catalog-heading">
				<div>
					<p class="eyebrow">GODOT 4 / MIT</p>
					<h2>
						Fourteen pieces
						<br />
						for your own game.
					</h2>
				</div>
				<div>
					<p>Small addons, each with one job. Explore the source or find them on the GDAM registry.</p>
					<a href="https://app.gdam.dev">Open the registry ↗</a>
				</div>
			</div>
			<div class="addon-grid">
				{addons.map((addon, index) => (
					<article>
						<span class="addon-number">{String(index + 1).padStart(2, '0')}</span>
						<h3>{addon.name}</h3>
						<p class="addon-tagline">{addon.tagline}</p>
						<details>
							<summary>What it does</summary>
							<p set:html={addon.copy} />
							{addon.cli && <small>{addon.cli}</small>}
						</details>
						<a href={`https://github.com/aviorstudio/${addon.name}`}>Source ↗</a>
					</article>
				))}
			</div>
		</section>
		<section class="tools-outro">
			<h2>See what they make possible.</h2>
			<a href="/games">Explore the games ↗</a>
		</section>
	</main>
</Full>
<style>
	.tools-cover,
	.featured-tools,
	.art-workbench,
	.addon-catalog,
	.tools-outro {
		width: min(1180px, calc(100% - 64px));
		margin: 0 auto 80px;
	}
	.tools-cover {
		padding-top: 50px;
	}
	.eyebrow {
		font: 10px var(--mono);
		letter-spacing: 0.12em;
		color: #637357;
	}
	.tools-cover h1 {
		font-size: clamp(55px, 7vw, 90px);
		line-height: 1.02;
		letter-spacing: -0.06em;
		font-weight: 550;
		margin: 30px 0;
	}
	.tools-cover h1 em,
	.art-workbench h2 em {
		font-family: Georgia, serif;
		font-weight: 400;
		color: #637357;
	}
	.tools-cover > p:last-child {
		font-size: 18px;
		line-height: 1.7;
		max-width: 600px;
		color: #596452;
	}
	.featured-tools {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 25px;
	}
	.featured-tools article {
		background: #dce6d0;
		border: 1px solid #c3d1b7;
		padding: 35px;
	}
	.featured-tools article:nth-child(2) {
		background: #e6e1d2;
		border-color: #d4ccba;
	}
	.tool-index {
		font: 10px var(--mono);
		color: #637357;
	}
	.featured-tools h2 {
		font-size: 40px;
		font-weight: 600;
		letter-spacing: -0.04em;
		margin: 25px 0 20px;
	}
	.featured-tools p {
		font-size: 15px;
		line-height: 1.7;
		color: #596452;
		max-width: 430px;
	}
	.tool-sample {
		padding: 22px;
		background: #f4f3eb;
		margin: 25px 0;
	}
	.tool-sample code {
		font: 12px/2 var(--mono);
		overflow-wrap: anywhere;
	}
	.tool-sample span {
		color: #7a735e;
	}
	.featured-tools a {
		display: inline-block;
		margin: 0 20px 8px 0;
		font-size: 12px;
		text-underline-offset: 5px;
		color: #253729;
	}
	.art-workbench {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 60px;
		align-items: center;
		background: #20382b;
		color: #e8eedf;
		padding: 40px;
	}
	.art-workbench .eyebrow {
		color: #b2c899;
	}
	.art-workbench h2 {
		font-size: 45px;
		line-height: 1.1;
		letter-spacing: -0.04em;
		font-weight: 500;
	}
	.art-workbench h2 em {
		color: #b2c899;
	}
	.art-workbench p:not(.eyebrow) {
		font-size: 14px;
		line-height: 1.7;
		color: #bbc7b0;
	}
	.vector-preview {
		display: flex;
		align-items: center;
	}
	.vector-preview img:first-child {
		width: 72%;
	}
	.vector-preview img:last-child {
		width: 32%;
		margin-left: -8%;
	}
	.catalog-heading {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 60px;
		align-items: end;
		margin-bottom: 35px;
	}
	.catalog-heading h2 {
		font-size: 40px;
		line-height: 1.1;
		font-weight: 550;
		letter-spacing: -0.04em;
		margin: 22px 0 0;
	}
	.catalog-heading p:not(.eyebrow) {
		font-size: 15px;
		line-height: 1.7;
		color: #596452;
	}
	.catalog-heading a {
		color: #253729;
		font-size: 12px;
		text-underline-offset: 5px;
	}
	.addon-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
	}
	.addon-grid article {
		background: #eceee2;
		border: 1px solid #d0d8c5;
		padding: 25px;
		display: flex;
		flex-direction: column;
	}
	.addon-number {
		font: 9px var(--mono);
		color: #758068;
	}
	.addon-grid h3 {
		font: 600 17px var(--mono);
		margin: 20px 0 10px;
	}
	.addon-tagline {
		font-size: 14px;
		line-height: 1.6;
		margin: 0 0 20px;
		color: #596452;
		min-height: 44px;
	}
	.addon-grid details {
		font-size: 12px;
		line-height: 1.7;
		color: #596452;
		margin-bottom: 20px;
	}
	.addon-grid summary {
		cursor: pointer;
		text-decoration: underline;
		text-underline-offset: 4px;
		color: #526447;
	}
	.addon-grid details p {
		font-size: 12px;
		line-height: 1.8;
	}
	.addon-grid details code {
		font-size: 11px;
		overflow-wrap: anywhere;
	}
	.addon-grid small {
		font: 9px/1.6 var(--mono);
	}
	.addon-grid a {
		font-size: 11px;
		color: #253729;
		margin-top: auto;
		text-underline-offset: 5px;
	}
	.tools-outro {
		border-top: 1px solid #c6cebd;
		padding: 35px 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 30px;
	}
	.tools-outro h2 {
		font-size: 26px;
		font-weight: 500;
		letter-spacing: -0.025em;
	}
	.tools-outro a {
		font-size: 13px;
		color: #253729;
		text-underline-offset: 5px;
	}
	@media (max-width: 900px) {
		.art-workbench {
			gap: 30px;
			padding: 30px;
		}
		.art-workbench h2 {
			font-size: 36px;
		}
		.addon-grid {
			grid-template-columns: 1fr 1fr;
		}
		.catalog-heading {
			gap: 35px;
		}
	}
	@media (max-width: 600px) {
		.tools-cover,
		.featured-tools,
		.art-workbench,
		.addon-catalog,
		.tools-outro {
			width: calc(100% - 40px);
			margin-bottom: 55px;
		}
		.tools-cover {
			padding-top: 25px;
		}
		.tools-cover h1 {
			font-size: 56px;
		}
		.tools-cover > p:last-child {
			font-size: 16px;
		}
		.featured-tools,
		.art-workbench,
		.catalog-heading,
		.addon-grid {
			grid-template-columns: 1fr;
		}
		.featured-tools article {
			padding: 28px;
		}
		.art-workbench {
			padding: 30px 24px;
		}
		.vector-preview {
			min-height: 200px;
		}
		.catalog-heading h2 {
			font-size: 36px;
		}
		.catalog-heading {
			gap: 20px;
		}
		.addon-grid article {
			padding: 24px;
		}
		.addon-tagline {
			min-height: 0;
		}
		.tools-outro {
			flex-direction: column;
			align-items: start;
			gap: 15px;
		}
		.tools-outro h2 {
			font-size: 25px;
		}
	}
</style>
