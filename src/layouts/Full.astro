---
import '../styles/global.css';
import octicons from '@primer/octicons';

interface Props {
	title?: string;
	description?: string;
	path?: string;
	noindex?: boolean;
}

const {
	title = 'Avior Studio',
	description = 'Independent games and useful developer tools. Play termcade, meet Fianchetto and Castle Drop, and explore the tools behind the work.',
	path = Astro.url.pathname,
	noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, 'https://avior.studio');
const icon = (name: keyof typeof octicons, size = 16) => octicons[name].toSVG({ width: size, height: size });

const nav = [
	{ href: '/devtools', label: 'Devtools' },
	{ href: '/games', label: 'Games' },
];

// A trailing slash is how a static host serves /devtools, so the comparison has
// to survive both forms or the current page never marks itself.
const current = (href: string) => path === href || path === `${href}/`;

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: 'Avior Studio',
	url: 'https://avior.studio',
	description,
	sameAs: ['https://github.com/aviorstudio', 'https://gdam.dev', 'https://gdlint.dev'],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#252424" />
		<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Avior Studio" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL('/logo.png', canonical)} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Avior Studio's white ibis standing in still water inside a dry-brush ring" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL('/logo.png', canonical)} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body><a class="skip-link" href="#main-content">Skip to content</a>
		<div class="page-shell">
			<header class="site-header">
				<a class="brand" href="/" aria-label="Avior Studio home">
					<img class="brand-mark" src="/mark/mark-96.png" alt="" width="96" height="96" />
					<span>Avior Studio</span>
				</a>
				<nav aria-label="Sections">
					{
						nav.map((item) => (
							<a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>
								{item.label}
							</a>
						))
					}
					<a class="out" href="https://github.com/aviorstudio">
						GitHub <span class="icon" set:html={icon('arrow-up-right', 13)} />
					</a>
				</nav>
			</header>

			<slot />

			<footer>
				<a class="brand footer-brand" href="/" aria-label="Avior Studio home">
					<img class="brand-mark" src="/mark/mark-96.png" alt="" width="96" height="96" />
					<span>Avior Studio</span>
				</a>
				<p><a href="/devtools">Devtools</a> · <a href="/games">Games</a> · <a href="https://github.com/aviorstudio">GitHub</a></p>
				<p>© {new Date().getFullYear()} Avior Studio</p>
			</footer>
		</div>
	</body>
</html>

<style is:global>
	.page-shell { min-height: 100svh; overflow-x: hidden; }

	.site-header { width: min(1180px, calc(100% - 40px)); height: 84px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
	.brand { display: inline-flex; align-items: center; gap: 10px; color: var(--bone); font: 500 19px var(--serif); letter-spacing: .01em; text-decoration: none; }
	.brand-mark { width: 44px; height: 44px; }
	.site-header nav { display: flex; align-items: center; gap: 26px; }
	.site-header nav a { color: var(--quiet); font-size: 13px; font-weight: 560; letter-spacing: .02em; text-decoration: none; border-bottom: 1px solid transparent; padding: 6px 0; transition: color .15s ease, border-color .15s ease; }
	.site-header nav a:hover { color: var(--bone); }
	.site-header nav a[aria-current='page'] { color: var(--bone); border-bottom-color: var(--seal); }
	.site-header nav .out { display: inline-flex; align-items: center; }
	.site-header nav .out span { margin-left: 5px; }
	.icon svg { display: block; fill: currentColor; }

	footer { width: min(1180px, calc(100% - 40px)); min-height: 140px; margin: 40px auto 0; display: grid; grid-template-columns: 1fr 1fr 1fr; align-items: center; border-top: 1px solid var(--line-soft); color: var(--faint); font: 500 11px var(--mono); }
	footer p { margin: 0; }
	footer p:nth-child(2) { text-align: center; }
	footer p:last-child { text-align: right; }
	footer a { color: var(--quiet); text-decoration: none; border-bottom: 1px solid var(--line); }
	footer a:hover { color: var(--bone); border-bottom-color: var(--bone); }
	footer a.footer-brand { justify-self: start; border: 0; font-size: 16px; }
	footer .brand-mark { width: 34px; height: 34px; }

	@media (max-width: 600px) {
		.site-header, footer { width: min(100% - 28px, 1180px); }
		.site-header { height: 68px; gap: 12px; }
		.brand span { display: none; }
		.site-header nav { gap: 18px; }
		.site-header nav a { font-size: 12.5px; }
		footer { grid-template-columns: 1fr; justify-items: start; gap: 14px; padding: 30px 0; }
		footer p:nth-child(2), footer p:last-child { text-align: left; }
	}
</style>
